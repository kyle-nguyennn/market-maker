# Perpetual Alpha: select the DEX to query.
# par = practice on Hyperliquid TESTNET, USDPR collateral.
# pas  = scored/live on Hyperliquid TESTNET, USDP collateral (NOT USDPR).
# Copy to .env (Git-ignored). python-dotenv loads .env for the CLI.
PERPETUAL_ALPHA_DEX=par

# Practice DEX: 19 Oct halt/settlement as announced by organizers.
PERPETUAL_ALPHA_PAR_NETWORK=testnet
PERPETUAL_ALPHA_PAR_API_URL=https://api.hyperliquid-testnet.xyz
PERPETUAL_ALPHA_PAR_WS_URL=wss://api.hyperliquid-testnet.xyz/ws
PERPETUAL_ALPHA_PAR_COLLATERAL=USDPR

# Scored DEX: must verify deployment, endpoint and wallet funding before trading.
PERPETUAL_ALPHA_PAS_NETWORK=testnet
PERPETUAL_ALPHA_PAS_API_URL=https://api.hyperliquid-testnet.xyz
PERPETUAL_ALPHA_PAS_WS_URL=wss://api.hyperliquid-testnet.xyz/ws
PERPETUAL_ALPHA_PAS_COLLATERAL=USDP

# Signed actions on pas are BLOCKED by default, even with an API key present.
# The deprecated PERPETUAL_ALPHA_PA_* settings are NOT scored DEX aliases.
# Migrate local .env to PERPETUAL_ALPHA_DEX=pas and PAS_* settings.
# Change only after the live DEX, wallet authorization and hard risk limits
# have been separately verified. This never enables trading from the CLI.
PERPETUAL_ALPHA_PAS_ALLOW_TRADING=false

# Public TEAM account address, NOT the API wallet's address.
PERPETUAL_ALPHA_TEAM_WALLET=0x95D8dbDED6265D43eFA604D3d8134Db5306a0354

# Private API/agent key is separate from the team/master wallet private key.
# Never put a real key in .env.template or check a .env into git.
# Revoke/replace any key previously disclosed in a screenshot.
PERPETUAL_ALPHA_API_PRIVATE_KEY=
